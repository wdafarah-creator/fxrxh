---
import { workSections } from '../data/nav.js';

const path = Astro.url.pathname;
const isAbout = path === '/about';
const isWork = path.startsWith('/work');
---

<header class="top-nav" transition:persist="top-nav">
	<nav class="top-nav__primary" aria-label="Primary">
		<div class="top-nav__item top-nav__item--dropdown">
			<span class="mono nav-word" class:list={[{ 'is-active': isWork }]} data-scramble tabindex="0">
				WORK
			</span>
			<ul class="top-nav__dropdown mono">
				{
					workSections.map((section) => (
						<li>
							<a href={section.href} data-scramble class:list={[{ 'is-active': path === section.href }]}>
								{section.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<a href="/about" class="mono nav-word" class:list={[{ 'is-active': isAbout }]} data-scramble>
			ABOUT
		</a>
	</nav>

	<div class="top-nav__social">
		<a
			href="https://instagram.com/fxrxh"
			target="_blank"
			rel="noreferrer noopener"
			aria-label="Instagram"
			data-cursor-hover
		>
			<svg width="18" height="18" viewBox="0 0 18 18" shape-rendering="crispEdges" fill="none">
				<rect x="2" y="2" width="14" height="14" stroke="currentColor" stroke-width="2" />
				<rect x="7" y="7" width="4" height="4" stroke="currentColor" stroke-width="2" />
				<rect x="12" y="3" width="2" height="2" fill="currentColor" />
			</svg>
		</a>
		<a href="mailto:hello@fxrxh.com" aria-label="Email" data-cursor-hover>
			<svg width="18" height="18" viewBox="0 0 18 18" shape-rendering="crispEdges" fill="none">
				<rect x="1" y="3" width="16" height="12" stroke="currentColor" stroke-width="2" />
				<path d="M2 4L9 10L16 4" stroke="currentColor" stroke-width="2" fill="none" />
			</svg>
		</a>
	</div>
</header>

<style>
	.top-nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--bar-height);
		padding: 0 clamp(1.25rem, 4vw, 2.5rem);
	}

	.top-nav__primary {
		display: flex;
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3rem);
	}

	.top-nav__item--dropdown {
		position: relative;
		padding-bottom: 0.75rem;
		margin-bottom: -0.75rem;
	}

	.nav-word {
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		color: var(--black);
		cursor: none;
		display: inline-block;
	}

	.nav-word.is-scrambling,
	a.is-scrambling {
		color: var(--hover-color, var(--red));
	}

	.nav-word.is-active {
		color: var(--grey-mid);
	}

	.top-nav__dropdown {
		position: absolute;
		top: 100%;
		left: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-top: 0.9rem;
		opacity: 0;
		visibility: hidden;
		transform: translateY(-4px);
		transition:
			opacity 0.22s var(--ease-smooth),
			transform 0.22s var(--ease-smooth),
			visibility 0.22s;
	}

	.top-nav__dropdown a {
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		color: var(--grey-dark);
		white-space: nowrap;
	}

	.top-nav__dropdown a.is-active {
		color: var(--grey-mid);
	}

	.top-nav__item--dropdown:hover .top-nav__dropdown,
	.top-nav__item--dropdown:focus-within .top-nav__dropdown {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.top-nav__social {
		display: flex;
		align-items: center;
		gap: 1rem;
		color: var(--black);
	}

	.top-nav__social a {
		display: flex;
		transition: color 0.15s var(--ease-smooth);
	}

	.top-nav__social a:hover {
		color: var(--red);
	}
</style>

<script>
	import { initNavInteractions } from '../scripts/nav-interactions.js';

	initNavInteractions();
	document.addEventListener('astro:page-load', () => initNavInteractions());
</script>
