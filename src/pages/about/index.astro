---
import Base from '../../layouts/Base.astro';

const options = [
	{ slug: 'a', name: 'Centred column', note: 'Film and copy as one centred stack, the text directly under the panel. Fixes the current split where the two float independently.' },
	{ slug: 'b', name: 'Side by side', note: 'Film one side, copy the other, both vertically centred. The most editorial, and the easiest to read.' },
	{ slug: 'c', name: 'Portrait strip', note: 'A tall narrow film running the full height on one edge, copy in a column beside it.' },
	{ slug: 'd', name: 'Text first', note: 'The words are the page, set large, with the film as a small inset. Puts what you do before what you look like.' },
	{ slug: 'e', name: 'Card over film', note: 'Film full-bleed again, copy in a dark panel floating over it. Keeps the atmosphere, keeps the text readable.' },
];
---

<Base title="About — layout options" noindex bodyClass="page">
	<div class="ao">
		<p class="ao__h">About page — five layouts</p>
		<p class="ao__hint">Each is a real page. Your current one is at <a href="/about">/about</a>.</p>
		<ol class="ao__list">
			{options.map((o, i) => (
				<li>
					<a class="ao__row" href={`/about/${o.slug}`}>
						<span class="ao__n">{String(i + 1).padStart(2, '0')}</span>
						<span class="ao__name">{o.name}</span>
					</a>
					<p class="ao__note">{o.note}</p>
				</li>
			))}
		</ol>
	</div>
</Base>

<style>
	.ao { max-width: 54rem; margin: 0 auto; padding: clamp(1.5rem, 5vw, 4rem); }
	.ao__h { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; opacity: .5; margin: 0 0 .5rem; }
	.ao__hint { font-size: .85rem; opacity: .45; margin: 0 0 2.6rem; }
	.ao__hint a { color: var(--acid); }
	.ao__list { list-style: none; margin: 0; padding: 0; }
	.ao__list li { border-top: 1px solid rgba(255,255,255,.14); padding: 1.4rem 0; }
	.ao__row { display: flex; align-items: baseline; gap: 1.2rem; color: var(--ink); text-decoration: none; }
	.ao__n { font-size: var(--fs-small); opacity: .45; font-variant-numeric: tabular-nums; }
	.ao__name { font-size: clamp(1.4rem, 4vw, 2.6rem); text-transform: uppercase; letter-spacing: var(--track); line-height: 1; }
	.ao__row:hover .ao__name { opacity: .6; }
	.ao__note { margin: .7rem 0 0; max-width: 56ch; font-size: .85rem; line-height: 1.5; opacity: .5; }
</style>
