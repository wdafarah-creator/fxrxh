---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Wordmark from '../components/Wordmark.astro';
import Icon from '../components/Icon.astro';

// One line in the bottom-right corner, cycling. There is no fixed label
// above it — what Farah is comes first in the rotation and then the
// disciplines follow, so the corner never carries more than a single line.
const lead = 'Multidisciplinary designer';

const disciplines = [
	'Graphic design',
	'Art direction',
	'Photography',
	'Videography',
	'Illustration',
	'CGI',
];
---

<Base
	title="Farah Awada — Multidisciplinary Designer | FXRXH"
	description="Portfolio of Farah Awada, multidisciplinary designer: brand identity, art direction, type design, photography, videography, illustration and CGI. Based in Spain, available for commissions."
	bodyClass="home"
>
	<video
		class="bg"
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		poster="/video/home-poster.jpg"
	>
		<source src="/video/home.webm" type="video/webm" />
		<source src="/video/home.mp4" type="video/mp4" />
	</video>

	<h1 class="sr-only">Farah Awada — multidisciplinary designer</h1>
	<div class="film" aria-hidden="true">
		<div class="film__grain"></div>
		<div class="film__screen"></div>
	</div>

	<div class="overlay">
		<div class="top">
			<Wordmark />

			<nav class="top__nav">
				<a class="btn btn--round" data-melt href="/work"><span>Work</span></a>
				<a class="btn btn--round" data-melt href="/about"><span>About</span></a>
				<Nav bare />
			</nav>
		</div>

		<div></div>

		{/* Balances the contact buttons in the opposite corner. */}
		<div class="disciplines" data-list={[lead, ...disciplines].join('|')}>
			<p class="disciplines__word" data-cycle>{lead}</p>
		</div>

		<div class="bottom">
			<a
				class="btn btn--with-icon"
				href="https://instagram.com/02fwa"
				target="_blank"
				rel="noopener noreferrer"><Icon name="instagram" />@02fwa</a
			>
			<a class="btn btn--with-icon" href="mailto:wdafarah@gmail.com">
				<Icon name="email" />wdafarah@gmail.com
			</a>
		</div>
	</div>
</Base>

<script>
	import '../scripts/melt.js';

	// The old line fades off, then the new one is drawn on left to right
	// behind a bright edge. The text is swapped while nothing is showing, so
	// the change itself is never seen.
	const word = document.querySelector('[data-cycle]');
	const box = word.closest('.disciplines');
	const list = [...box.dataset.list.split('|')];
	let at = 0;

	// matched to the transition and the laser-cut keyframes in global.css
	const FADE = 180;
	const HOLD = 1500;

	setInterval(() => {
		word.classList.add('is-out');
		setTimeout(() => {
			at = (at + 1) % list.length;
			word.textContent = list[at];
			word.classList.remove('is-out');

			// the class has to come off and the layout be read back before it
			// goes on again, or the animation does not restart
			box.classList.remove('is-in');
			void box.offsetWidth;
			box.classList.add('is-in');
		}, FADE);
	}, HOLD);
</script>
