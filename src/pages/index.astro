---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Wordmark from '../components/Wordmark.astro';
import Icon from '../components/Icon.astro';

// Flush-right edge now comes from CSS alignment, not typed dashes — so it
// holds in any typeface.
// Scattered across the frame, several running off the edges. top/left are
// percentages of the viewport; negative and >100 values are the bleed.
// Starting positions only — every line stays inside the frame and bounces
// off the edges from here. See src/scripts/drift.js.
const disciplines = [
	{ text: 'MULTIDISCIPLINARY DESIGNER', top: 14, left: 6 },
	{ text: 'GRAPHIC DESIGN', top: 29, left: 64 },
	{ text: 'ART DIRECTION', top: 46, left: 13 },
	{ text: 'PHOTOGRAPHY', top: 61, left: 68 },
	{ text: 'VIDEOGRAPHY', top: 75, left: 9 },
	{ text: 'ILLUSTRATION', top: 87, left: 50 },
];
---

<Base
	title="Farah Awada — Multidisciplinary Designer | FXRXH"
	description="Portfolio of Farah Awada, multidisciplinary designer: brand identity, art direction, type design, photography, videography, illustration and CGI. Based in Spain, available for commissions."
	bodyClass="home"
>
	<video
		class="bg"
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		poster="/video/home-poster.jpg"
	>
		<source src="/video/home.webm" type="video/webm" />
		<source src="/video/home.mp4" type="video/mp4" />
	</video>

	<h1 class="sr-only">Farah Awada — multidisciplinary designer</h1>
	<div class="film" aria-hidden="true">
		<div class="film__grain"></div>
		<div class="film__screen"></div>
	</div>

	<div class="overlay">
		{/* Absolutely positioned stage over the whole frame — the lines are
		    placed and bounced by src/scripts/drift.js. */}
		<div class="disciplines">
			{
				disciplines.map((d) => (
					<span data-melt style={`--top:${d.top}%; --left:${d.left}%`}>
						{d.text}
					</span>
				))
			}
		</div>

		<div class="top">
			<Wordmark />

			<nav class="top__nav">
				<a class="btn btn--round" data-melt href="/work"><span>Work</span></a>
				<a class="btn btn--round" data-melt href="/about"><span>About</span></a>
				<Nav bare />
			</nav>
		</div>

		<div></div>

		<div class="bottom">
			<a
				class="btn btn--with-icon"
				href="https://instagram.com/02fwa"
				target="_blank"
				rel="noopener noreferrer"><Icon name="instagram" />@02fwa</a
			>
			<a class="btn btn--with-icon" href="mailto:wdafarah@gmail.com">
				<Icon name="email" />wdafarah@gmail.com
			</a>
		</div>
	</div>
</Base>

<script>
	import '../scripts/melt.js';
	import '../scripts/drift.js';
</script>
