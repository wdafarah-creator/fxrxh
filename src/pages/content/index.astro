---
import Base from '../../layouts/Base.astro';

const options = [
	{ slug: 'a', name: 'Contact sheet', note: 'All 22 as a grid of small silent loops. Total overview, no scrolling — click one to open it full size.' },
	{ slug: 'b', name: 'Filmstrip', note: 'A horizontal rail you scroll sideways through. Short clips read as frames on a timeline rather than as a queue.' },
	{ slug: 'c', name: 'List & player', note: 'One player, with all 22 titles listed beside it. Hovering a title changes the film — nothing autoplays at full size.' },
	{ slug: 'd', name: 'Grouped column', note: 'Medium-size clips in a column, split into camera work, motion and AI. Half-screen each, so two are visible at once.' },
];
---

<Base title="Content — display options" noindex bodyClass="page">
	<div class="co">
		<p class="co__h">Art direction &amp; content — four ways to show 22 films</p>
		<p class="co__hint">Current version is at <a href="/work/art-direction-content">/work/art-direction-content</a>.</p>
		<ol class="co__list">
			{options.map((o, i) => (
				<li>
					<a class="co__row" href={`/content/${o.slug}`}>
						<span class="co__n">{String(i + 1).padStart(2, '0')}</span>
						<span class="co__name">{o.name}</span>
					</a>
					<p class="co__note">{o.note}</p>
				</li>
			))}
		</ol>
	</div>
</Base>

<style>
	.co { max-width: 54rem; margin: 0 auto; padding: clamp(1.5rem, 5vw, 4rem); }
	.co__h { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; opacity: .5; margin: 0 0 .5rem; }
	.co__hint { font-size: .85rem; opacity: .45; margin: 0 0 2.6rem; }
	.co__hint a { color: var(--acid); }
	.co__list { list-style: none; margin: 0; padding: 0; }
	.co__list li { border-top: 1px solid rgba(255,255,255,.14); padding: 1.4rem 0; }
	.co__row { display: flex; align-items: baseline; gap: 1.2rem; color: var(--ink); text-decoration: none; }
	.co__n { font-size: var(--fs-small); opacity: .45; font-variant-numeric: tabular-nums; }
	.co__name { font-size: clamp(1.4rem, 4vw, 2.6rem); text-transform: uppercase; letter-spacing: var(--track); line-height: 1; }
	.co__row:hover .co__name { opacity: .6; }
	.co__note { margin: .7rem 0 0; max-width: 58ch; font-size: .85rem; line-height: 1.5; opacity: .5; }
</style>
