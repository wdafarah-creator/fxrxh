---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
import { sections } from '../../data/work.js';
---

<Base title="Home G — two doors" noindex bodyClass="home">
	<video class="bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" />
		<source src="/video/home.mp4" type="video/mp4" />
	</video>
	<div class="film" aria-hidden="true"><div class="film__grain"></div><div class="film__lines"></div></div>

	<div class="overlay hg">
		<div class="top">
			<Wordmark />
			<nav class="top__nav"><Nav bare /></nav>
		</div>

		<nav class="hg__doors">
			{sections.map((s) => (
				<a class="hg__door" href={`/work/${s.slug}`}>
					<span class="hg__t">{s.title}</span>
					<span class="hg__c">{s.count} {s.unit}</span>
				</a>
			))}
		</nav>

		<div class="hg__foot"><a href="/about">About</a><span>Based in Spain</span></div>
	</div>
</Base>

<style>
	.hg { grid-template-rows: auto 1fr auto; }
	.hg__doors { display: grid; place-content: center; gap: clamp(.6rem, 2vh, 1.6rem); }
	.hg__door { color: var(--ink); text-decoration: none; pointer-events: auto; display: grid; gap: .3rem; }
	.hg__t {
		font-size: clamp(2rem, 9vw, 6.5rem); line-height: .92; letter-spacing: -.04em;
		text-transform: uppercase; transition: padding-left .5s var(--ease-smooth);
	}
	.hg__door:hover .hg__t { padding-left: clamp(.6rem, 2vw, 2rem); }
	.hg__c { font-size: var(--fs-small); letter-spacing: .08em; opacity: .7; }
	.hg__foot { display: flex; justify-content: space-between; font-size: var(--fs-small); }
	.hg__foot a { color: var(--ink); pointer-events: auto; }
</style>
