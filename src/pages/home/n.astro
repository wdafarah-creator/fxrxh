---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
import { graphicProjects } from '../../data/graphic.js';

const projects = [...graphicProjects].sort((a, b) => a.title.localeCompare(b.title));
---

<Base title="Home N — ticker" noindex bodyClass="home">
	<video class="bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" /><source src="/video/home.mp4" type="video/mp4" />
	</video>
	<div class="film" aria-hidden="true"><div class="film__grain"></div><div class="film__lines"></div></div>

	<div class="overlay hn">
		<div class="top"><Wordmark /><nav class="top__nav"><Nav bare /></nav></div>
		<div></div>
		<div class="hn__foot"><a href="/about">About</a><span>Farah Awada — multidisciplinary designer</span></div>
	</div>

	<div class="hn__belt" aria-label="Projects">
		<div class="hn__col">
			{[0, 1].map(() => (
				<span class="hn__set" aria-hidden="true">
					{projects.map((p) => (
						<a class="hn__item" href={`/work/graphic-design/${p.slug}`}>{p.title}</a>
					))}
				</span>
			))}
		</div>
	</div>
</Base>

<style>
	.hn__foot { align-self: end; display: flex; justify-content: space-between; font-size: var(--fs-small); }
	.hn__foot a { color: var(--ink); pointer-events: auto; }
	.hn__belt {
		position: fixed; top: 0; bottom: 0; right: 0; z-index: 6;
		width: min(26rem, 52vw); overflow: hidden;
		-webkit-mask-image: linear-gradient(transparent, #000 18%, #000 82%, transparent);
		mask-image: linear-gradient(transparent, #000 18%, #000 82%, transparent);
	}
	.hn__col { display: flex; flex-direction: column; animation: hn-roll 26s linear infinite; }
	.hn__set { display: flex; flex-direction: column; }
	.hn__item {
		padding: .22rem 1.2rem; color: var(--ink); text-decoration: none; white-space: nowrap;
		font-size: clamp(1.2rem, 3.6vw, 2.6rem); line-height: 1.08; letter-spacing: -.03em;
		text-transform: uppercase; opacity: .45; pointer-events: auto;
		transition: opacity .25s var(--ease-smooth);
	}
	.hn__item:hover { opacity: 1; }
	@keyframes hn-roll { from { transform: translateY(0); } to { transform: translateY(-50%); } }
	.hn__belt:hover .hn__col { animation-play-state: paused; }
	@media (prefers-reduced-motion: reduce) { .hn__col { animation: none; } }
</style>
