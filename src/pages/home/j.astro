---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
---

<Base title="Home J — marquee CTA" noindex bodyClass="home">
	<video class="bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" />
		<source src="/video/home.mp4" type="video/mp4" />
	</video>
	<div class="film" aria-hidden="true"><div class="film__grain"></div><div class="film__lines"></div></div>

	<div class="overlay hj">
		<div class="top">
			<Wordmark />
			<nav class="top__nav"><Nav bare /></nav>
		</div>
		<div></div>
		<div class="hj__foot">
			<span>Graphic design · Art direction · CGI</span>
			<a href="/about">About</a>
		</div>
	</div>

	{/* Outside the blend so it reads as itself over any frame. */}
	<a class="hj__band" href="/work" aria-label="See the work">
		<span class="hj__track">
			{[0, 1, 2, 3].map(() => (
				<span class="hj__set" aria-hidden="true">
					<span class="hj__w">See the work</span><span class="hj__s">✳</span>
				</span>
			))}
		</span>
	</a>
</Base>

<style>
	.hj__foot { align-self: end; display: flex; justify-content: space-between; font-size: var(--fs-small); margin-bottom: 1rem; }
	.hj__foot a { color: var(--ink); pointer-events: auto; }

	.hj__band {
		position: fixed; top: 50%; left: 0; right: 0; translate: 0 -50%; z-index: 6;
		overflow: hidden; display: block; text-decoration: none; color: var(--ink);
		padding: clamp(.4rem, 1.5vh, 1rem) 0;
		border-top: 1px solid rgba(255,255,255,.22); border-bottom: 1px solid rgba(255,255,255,.22);
		background: rgba(7,7,10,.35);
		-webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
	}
	.hj__track { display: flex; width: max-content; animation: hj-roll 18s linear infinite; }
	.hj__set { display: flex; align-items: center; }
	.hj__w {
		font-size: clamp(1.8rem, 7vw, 5rem); line-height: 1; letter-spacing: -.03em;
		text-transform: uppercase; white-space: nowrap; padding: 0 1.2rem;
	}
	.hj__s { font-size: clamp(1rem, 3vw, 2.2rem); opacity: .55; padding: 0 1.2rem; }
	@keyframes hj-roll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
	.hj__band:hover .hj__track { animation-play-state: paused; }
	@media (prefers-reduced-motion: reduce) { .hj__track { animation: none; } }
</style>
