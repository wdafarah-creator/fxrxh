---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
import { graphicProjects } from '../../data/graphic.js';

const projects = [...graphicProjects].sort((a, b) => a.title.localeCompare(b.title));
---

<Base title="Home O — numerals" noindex bodyClass="home">
	<video class="bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" /><source src="/video/home.mp4" type="video/mp4" />
	</video>
	<div class="film" aria-hidden="true"><div class="film__grain"></div><div class="film__lines"></div></div>

	<div class="overlay ho2">
		<div class="top"><Wordmark /><nav class="top__nav"><Nav bare /></nav></div>

		<div class="ho2__mid">
			<nav class="ho2__grid">
				{projects.map((p, i) => (
					<a class="ho2__n" href={`/work/graphic-design/${p.slug}`} data-name={p.title}>
						{String(i + 1).padStart(2, '0')}
					</a>
				))}
			</nav>
			<p class="ho2__read" data-read>Twelve projects</p>
		</div>

		<div class="ho2__foot"><a href="/about">About</a><a href="/work/art-direction-content">22 films →</a></div>
	</div>
</Base>

<script>
	const read = document.querySelector('[data-read]');
	const base = read?.textContent ?? '';
	document.querySelectorAll('[data-name]').forEach((n) => {
		n.addEventListener('mouseenter', () => { if (read) read.textContent = n.dataset.name; });
		n.addEventListener('mouseleave', () => { if (read) read.textContent = base; });
	});
</script>

<style>
	.ho2 { grid-template-rows: auto 1fr auto; }
	.ho2__mid { display: grid; align-content: center; justify-items: center; gap: 1.4rem; }
	.ho2__grid { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(.3rem, 1.6vw, 1.1rem); }
	.ho2__n {
		color: var(--ink); text-decoration: none; pointer-events: auto;
		font-size: clamp(1.6rem, 6.5vw, 4.6rem); line-height: 1; letter-spacing: -.04em;
		font-variant-numeric: tabular-nums; opacity: .45;
		transition: opacity .25s var(--ease-smooth), transform .35s var(--ease-smooth);
	}
	.ho2__grid:hover .ho2__n { opacity: .22; }
	.ho2__grid .ho2__n:hover { opacity: 1; transform: translateY(-5px); }
	.ho2__read { margin: 0; font-size: var(--fs-small); letter-spacing: .14em; opacity: .8; min-height: 1.2em; }
	.ho2__foot { display: flex; justify-content: space-between; font-size: var(--fs-small); }
	.ho2__foot a { color: var(--ink); pointer-events: auto; }
</style>
