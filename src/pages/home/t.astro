---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
import { graphicProjects } from '../../data/graphic.js';

const projects = [...graphicProjects].sort((a, b) => a.title.localeCompare(b.title));
---

<Base title="Home T — sideways" noindex bodyClass="page ht-page">
	<video class="ht__bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.mp4" type="video/mp4" />
	</video>

	<header class="ht__bar">
		<Wordmark />
		<nav class="top__nav"><Nav bare /></nav>
	</header>

	<div class="ht__rail">
		<section class="ht__intro">
			<p>Farah Awada</p>
			<p class="ht__sub">Multidisciplinary designer — graphic design, art direction, CGI</p>
			<span class="ht__cue">Scroll →</span>
		</section>

		{projects.map((p, i) => (
			<a class="ht__card" href={`/work/graphic-design/${p.slug}`}>
				<img src={`/img/work/${p.slug}/${p.cover ?? p.images.find((x) => x.file).file}`} alt="" loading="lazy" />
				<span class="ht__m"><b>{String(i + 1).padStart(2, '0')}</b> {p.title}</span>
			</a>
		))}

		<section class="ht__end">
			<a href="/work/art-direction-content">22 films →</a>
			<a href="/about">About</a>
		</section>
	</div>
</Base>

<script>
	// A vertical wheel should drive a horizontal rail.
	const rail = document.querySelector('.ht__rail');
	rail?.addEventListener('wheel', (e) => {
		if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
		e.preventDefault();
		rail.scrollLeft += e.deltaY;
	}, { passive: false });
</script>

<style>
	body.ht-page { background: #000; overflow: hidden; }
	.ht__bg { position: fixed; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; filter: brightness(.45) grayscale(.5); }
	.ht__bar {
		position: fixed; top: 0; left: 0; right: 0; z-index: 10;
		display: flex; justify-content: space-between; align-items: center;
		padding: var(--pad); pointer-events: none;
	}
	.ht__bar a, .ht__bar button { pointer-events: auto; }
	.ht__rail {
		position: fixed; inset: 0; z-index: 2;
		display: flex; align-items: center; gap: clamp(.6rem, 1.6vw, 1.2rem);
		padding: 0 var(--pad); overflow-x: auto; overflow-y: hidden;
		scroll-snap-type: x proximity; scrollbar-width: none;
	}
	.ht__rail::-webkit-scrollbar { display: none; }
	.ht__intro, .ht__end {
		flex: 0 0 auto; display: grid; gap: .5rem; align-content: center;
		color: var(--ink); text-transform: uppercase; letter-spacing: .08em;
		font-size: var(--fs-small); padding-right: clamp(1rem, 4vw, 3rem);
	}
	.ht__intro p:first-child { font-size: clamp(1.4rem, 4vw, 2.6rem); letter-spacing: var(--track); margin: 0; }
	.ht__sub { max-width: 26ch; opacity: .75; margin: 0; }
	.ht__cue { opacity: .6; }
	.ht__end a { color: var(--ink); }
	.ht__card {
		flex: 0 0 auto; width: clamp(12rem, 26vw, 22rem); height: 62vh;
		position: relative; overflow: hidden; border-radius: 2px; scroll-snap-align: center;
		color: var(--ink); text-decoration: none; background: #0a0a0a;
	}
	.ht__card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s var(--ease-smooth); }
	.ht__card:hover img { transform: scale(1.04); }
	.ht__m {
		position: absolute; left: .8rem; bottom: .8rem; font-size: var(--fs-small);
		text-transform: uppercase; letter-spacing: var(--track-small); text-shadow: 0 2px 10px rgba(0,0,0,.9);
	}
	.ht__m b { font-weight: 400; opacity: .6; margin-right: .4em; }
</style>
