---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
---

<Base title="Home F — enter" noindex bodyClass="home">
	<video class="bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" />
		<source src="/video/home.mp4" type="video/mp4" />
	</video>
	<div class="film" aria-hidden="true"><div class="film__grain"></div><div class="film__lines"></div></div>

	<div class="overlay hf">
		<div class="top">
			<Wordmark />
			<nav class="top__nav"><Nav bare /></nav>
		</div>

		<a class="hf__door" href="/work">
			<span class="hf__word">Enter</span>
			<span class="hf__sub">Farah Awada — graphic design, art direction, CGI</span>
		</a>

		<div class="hf__foot"><a href="/about">About</a><span>@02fwa</span></div>
	</div>
</Base>

<style>
	.hf { grid-template-rows: auto 1fr auto; }
	.hf__door { display: grid; place-content: center; justify-items: center; gap: 1.2rem; color: var(--ink); text-decoration: none; pointer-events: auto; }
	.hf__word {
		font-size: clamp(3.5rem, 22vw, 17rem); line-height: .82; letter-spacing: -.05em;
		text-transform: uppercase; transition: letter-spacing .7s var(--ease-smooth);
	}
	.hf__door:hover .hf__word { letter-spacing: .02em; }
	.hf__sub { font-size: var(--fs-small); letter-spacing: .1em; opacity: .75; text-align: center; }
	.hf__foot { display: flex; justify-content: space-between; font-size: var(--fs-small); }
	.hf__foot a { color: var(--ink); pointer-events: auto; }
</style>
