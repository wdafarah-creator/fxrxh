---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';

const clients = [
	'Tribe', 'Goosebumps Garden', 'Crumb Cult', 'Hypnotik', 'Fjaka',
	'Seawolf', 'High Grade Club', 'Inkdentidad', 'Itef', 'Sara Selina', 'IDRAAC',
];
---

<Base title="Home D — marquee" noindex bodyClass="home">
	<video class="bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" />
		<source src="/video/home.mp4" type="video/mp4" />
	</video>
	<div class="film" aria-hidden="true"><div class="film__grain"></div><div class="film__lines"></div></div>

	<div class="overlay hd">
		<div class="top">
			<Wordmark />
			<nav class="top__nav">
				<a class="btn btn--round" href="/work"><span>Work</span></a>
				<a class="btn btn--round" href="/about"><span>About</span></a>
				<Nav bare />
			</nav>
		</div>

		<div></div>

		<div class="hd__bottom">
			<p class="hd__lead">Multidisciplinary designer — graphic design, art direction and CGI.</p>
		</div>
	</div>

	{/* Outside the blend so the band reads as itself, not an inversion. */}
	<div class="hd__marquee" aria-label="Selected clients">
		<div class="hd__track">
			{[0, 1].map(() => (
				<span class="hd__set" aria-hidden="true">
					{clients.map((c) => (<span class="hd__item">{c}</span>))}
				</span>
			))}
		</div>
	</div>
</Base>

<style>
	.hd__bottom { align-self: end; }
	.hd__lead { margin: 0 0 4.4rem; max-width: 34ch; font-size: var(--fs-small); letter-spacing: .04em; }

	.hd__marquee {
		position: fixed; left: 0; right: 0; bottom: 0; z-index: 6;
		overflow: hidden; padding: .7rem 0;
		border-top: 1px solid rgba(255,255,255,.18);
		background: rgba(7,7,10,.55);
		-webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
	}
	.hd__track { display: flex; width: max-content; animation: hd-roll 38s linear infinite; }
	.hd__set { display: flex; }
	.hd__item {
		padding: 0 2.2rem; font-size: var(--fs-small); text-transform: uppercase;
		letter-spacing: .1em; color: var(--ink); opacity: .8; white-space: nowrap;
	}
	.hd__item::after { content: '✳'; margin-left: 2.2rem; opacity: .45; }
	@keyframes hd-roll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
	.hd__marquee:hover .hd__track { animation-play-state: paused; }
	@media (prefers-reduced-motion: reduce) { .hd__track { animation: none; } }
</style>
