---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
---

<Base title="Home A — reel first" noindex bodyClass="home">
	<video class="bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" />
		<source src="/video/home.mp4" type="video/mp4" />
	</video>
	<div class="film" aria-hidden="true"><div class="film__grain"></div><div class="film__lines"></div></div>

	<div class="overlay ha">
		<div class="top">
			<Wordmark />
			<nav class="top__nav"><Nav bare /></nav>
		</div>

		<div class="ha__mid">
			<p class="ha__kicker">Farah Awada — multidisciplinary designer</p>
			<a class="ha__cta" href="/work">See the work</a>
		</div>

		<div class="ha__foot">
			<span>Graphic design · Art direction · CGI</span>
			<a href="/about">About</a>
		</div>
	</div>
</Base>

<style>
	.ha { grid-template-rows: auto 1fr auto; }
	.ha__mid { display: grid; place-content: center; text-align: center; gap: 1.4rem; }
	.ha__kicker { margin: 0; font-size: var(--fs-small); letter-spacing: 0.08em; opacity: 0.8; }
	.ha__cta {
		font-size: clamp(2.2rem, 11vw, 8rem); line-height: 0.92; letter-spacing: -0.04em;
		text-transform: uppercase; color: var(--ink); text-decoration: none; pointer-events: auto;
		transition: letter-spacing .5s var(--ease-smooth);
	}
	.ha__cta:hover { letter-spacing: -0.015em; }
	.ha__foot { display: flex; justify-content: space-between; align-items: end; font-size: var(--fs-small); }
	.ha__foot a { color: var(--ink); pointer-events: auto; }
</style>
