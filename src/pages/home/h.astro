---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
---

<Base title="Home H — scramble verb" noindex bodyClass="home">
	<video class="bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" />
		<source src="/video/home.mp4" type="video/mp4" />
	</video>
	<div class="film" aria-hidden="true"><div class="film__grain"></div><div class="film__lines"></div></div>

	<div class="overlay hh">
		<div class="top">
			<Wordmark />
			<nav class="top__nav"><Nav bare /></nav>
		</div>

		<a class="hh__cta" href="/work">
			<span class="hh__verb" data-verb>See</span>
			<span class="hh__rest">the work</span>
		</a>

		<div class="hh__foot"><a href="/about">About</a><span>wdafarah@gmail.com</span></div>
	</div>
</Base>

<script>
	// The verb decodes between synonyms, the same move the FXRXH mark makes.
	const el = document.querySelector('[data-verb]');
	if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const WORDS = ['See', 'Watch', 'Read', 'Open'];
		const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
		let at = 0;
		const scramble = (next, done) => {
			const t0 = performance.now();
			const tick = () => {
				if (performance.now() - t0 >= 360) { el.textContent = next; return done(); }
				el.textContent = Array.from({ length: next.length }, () => GLYPHS[(Math.random() * 26) | 0]).join('');
				setTimeout(tick, 55);
			};
			tick();
		};
		const loop = () => setTimeout(() => {
			at = (at + 1) % WORDS.length;
			scramble(WORDS[at], loop);
		}, 2400);
		loop();
	}
</script>

<style>
	.hh { grid-template-rows: auto 1fr auto; }
	.hh__cta {
		display: grid; place-content: center; justify-items: center; color: var(--ink);
		text-decoration: none; pointer-events: auto; line-height: .9; text-transform: uppercase;
	}
	.hh__verb {
		display: block; min-width: 5ch; text-align: center;
		font-size: clamp(3rem, 17vw, 13rem); letter-spacing: -.05em;
	}
	.hh__rest { display: block; font-size: clamp(1rem, 4.5vw, 3.2rem); letter-spacing: .02em; opacity: .85; }
	.hh__foot { display: flex; justify-content: space-between; font-size: var(--fs-small); }
	.hh__foot a { color: var(--ink); pointer-events: auto; }
</style>
