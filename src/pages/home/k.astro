---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';

const lines = [
	{ t: 'Brand identity', h: '/work/graphic-design' },
	{ t: 'Art direction', h: '/work/art-direction-content' },
	{ t: 'Type design', h: '/work/graphic-design' },
	{ t: 'Film & CGI', h: '/work/art-direction-content' },
];
---

<Base title="Home K — word stack" noindex bodyClass="home">
	<video class="bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" /><source src="/video/home.mp4" type="video/mp4" />
	</video>
	<div class="film" aria-hidden="true"><div class="film__grain"></div><div class="film__lines"></div></div>

	<div class="overlay hk">
		<div class="top"><Wordmark /><nav class="top__nav"><Nav bare /></nav></div>
		<nav class="hk__stack">
			{lines.map((l) => (<a class="hk__line" href={l.h}>{l.t}</a>))}
		</nav>
		<div class="hk__foot"><a href="/about">About</a><span>Farah Awada</span></div>
	</div>
</Base>

<style>
	.hk { grid-template-rows: auto 1fr auto; }
	.hk__stack { display: grid; align-content: center; }
	.hk__line {
		color: var(--ink); text-decoration: none; pointer-events: auto;
		font-size: clamp(1.7rem, 8vw, 5.6rem); line-height: .98; letter-spacing: -.035em;
		text-transform: uppercase; opacity: .5; transition: opacity .35s var(--ease-smooth), padding-left .45s var(--ease-smooth);
	}
	.hk__stack:hover .hk__line { opacity: .3; }
	.hk__stack .hk__line:hover { opacity: 1; padding-left: clamp(.5rem, 2vw, 1.6rem); }
	.hk__foot { display: flex; justify-content: space-between; font-size: var(--fs-small); }
	.hk__foot a { color: var(--ink); pointer-events: auto; }
</style>
