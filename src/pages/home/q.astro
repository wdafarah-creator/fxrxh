---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
---

<Base title="Home Q — torch" noindex bodyClass="home">
	<video class="bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" /><source src="/video/home.mp4" type="video/mp4" />
	</video>

	{/* The film is covered; the cursor cuts a hole in the cover. */}
	<div class="hq__shade" data-shade></div>

	<div class="overlay hq">
		<div class="top"><Wordmark /><nav class="top__nav"><Nav bare /></nav></div>
		<div class="hq__mid"><a href="/work">See the work</a></div>
		<div class="hq__foot"><a href="/about">About</a><span>Move the cursor</span></div>
	</div>
</Base>

<script>
	const shade = document.querySelector('[data-shade]');
	if (shade && window.matchMedia('(hover: hover)').matches) {
		let x = innerWidth / 2, y = innerHeight / 2, raf = null;
		const paint = () => { raf = null; shade.style.setProperty('--x', x + 'px'); shade.style.setProperty('--y', y + 'px'); };
		addEventListener('mousemove', (e) => { x = e.clientX; y = e.clientY; if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
		paint();
	} else if (shade) {
		shade.style.opacity = '0.35';
	}
</script>

<style>
	.hq__shade {
		position: fixed; inset: 0; z-index: 2; pointer-events: none; background: #000;
		--x: 50vw; --y: 50vh;
		-webkit-mask-image: radial-gradient(circle 15rem at var(--x) var(--y), transparent 0%, transparent 42%, #000 100%);
		mask-image: radial-gradient(circle 15rem at var(--x) var(--y), transparent 0%, transparent 42%, #000 100%);
	}
	.hq { z-index: 4; }
	.hq__mid { display: grid; place-content: center; }
	.hq__mid a {
		color: var(--ink); text-decoration: none; pointer-events: auto;
		font-size: clamp(1.4rem, 5.5vw, 4rem); letter-spacing: -.03em; text-transform: uppercase;
	}
	.hq__foot { align-self: end; display: flex; justify-content: space-between; font-size: var(--fs-small); }
	.hq__foot a { color: var(--ink); pointer-events: auto; }
</style>
