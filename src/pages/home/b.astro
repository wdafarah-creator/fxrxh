---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
import { graphicProjects } from '../../data/graphic.js';
import { artDirection } from '../../data/work.js';

const projects = [...graphicProjects].sort((a, b) => a.title.localeCompare(b.title));
---

<Base title="Home B — index" noindex bodyClass="page">
	<div class="hb">
		<header class="hb__top">
			<Wordmark />
			<Nav bare />
		</header>

		<p class="hb__lead">
			Farah Awada — multidisciplinary designer. Brand identity, art direction, type,
			photography, videography and CGI. Based in Spain.
		</p>

		<p class="hb__sec">Graphic design — {projects.length} projects</p>
		<ol class="hb__list">
			{projects.map((p) => (
				<li>
					<a href={`/work/graphic-design/${p.slug}`}>
						<span>{p.title}</span>
						<em>{p.scope}</em>
					</a>
				</li>
			))}
		</ol>

		<p class="hb__sec">Art direction &amp; content — {artDirection.length} pieces</p>
		<ol class="hb__list hb__list--tight">
			{artDirection.map((c) => (
				<li><a href="/work/art-direction-content"><span>{c.title}</span><em>{c.dur}</em></a></li>
			))}
		</ol>

		<p class="hb__sec">
			<a href="/about">About</a> · <a href="mailto:wdafarah@gmail.com">wdafarah@gmail.com</a>
		</p>
	</div>
</Base>

<style>
	.hb { max-width: 60rem; margin: 0 auto; padding: clamp(1.5rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem) 6rem; }
	.hb__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: clamp(2rem, 6vw, 4rem); }
	.hb__lead { max-width: 44ch; font-size: clamp(1.1rem, 2.4vw, 1.8rem); line-height: 1.3; letter-spacing: var(--track); margin: 0 0 clamp(2.5rem, 7vw, 5rem); }
	.hb__sec { font-size: var(--fs-small); letter-spacing: 0.08em; opacity: 0.45; margin: clamp(2rem, 5vw, 3.4rem) 0 0.8rem; }
	.hb__sec a { color: var(--ink); }
	.hb__list { list-style: none; margin: 0; padding: 0; }
	.hb__list li { border-top: 1px solid rgba(255,255,255,.14); }
	.hb__list li:last-child { border-bottom: 1px solid rgba(255,255,255,.14); }
	.hb__list a {
		display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
		padding: 0.5rem 0; color: var(--ink); text-decoration: none;
		font-size: clamp(1.1rem, 3vw, 2.1rem); text-transform: uppercase; letter-spacing: var(--track);
		transition: padding-left .4s var(--ease-smooth), color .3s var(--ease-smooth);
	}
	.hb__list a:hover { padding-left: 0.8rem; color: var(--acid); }
	.hb__list em { font-style: normal; font-size: var(--fs-small); opacity: 0.45; letter-spacing: var(--track-small); flex-shrink: 0; }
	.hb__list--tight a { font-size: clamp(0.95rem, 2vw, 1.3rem); }
</style>
