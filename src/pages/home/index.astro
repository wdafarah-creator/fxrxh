---
import Base from '../../layouts/Base.astro';

const options = [
	{ slug: 'a', name: 'Reel first', note: 'The footage is the whole page and it says one thing: see the work. Everything else is a single line. Assumes nobody scrolls.' },
	{ slug: 'b', name: 'Index', note: 'No video at all — the whole site as one typographic list, every project reachable in a click. The fastest to use, the least atmospheric.' },
	{ slug: 'c', name: 'Split', note: 'Footage on one side, a live index on the other. Hovering a title changes the film. Atmosphere and navigation at once.' },
	{ slug: 'd', name: 'Marquee', note: 'The current home plus a band of client names running across it. Puts the roster in front of people instead of burying it in project pages.' },
	{ slug: 'e', name: 'Contact sheet', note: 'A wall of silent looping clips and covers behind the mark. The work itself is the background.' },
	{ slug: 'f', name: 'Enter', note: 'One word filling the screen. The least said of any of them — the film does the talking and the page is a door.' },
	{ slug: 'g', name: 'Two doors', note: 'The two sections as the only words on the page, set huge. Skips the generic Work step entirely.' },
	{ slug: 'h', name: 'Scramble verb', note: 'See / Watch / Read / Open the work — the verb decodes between words, the same move the FXRXH mark makes.' },
	{ slug: 'i', name: 'By the numbers', note: 'The counts as the headline: 12 projects, 22 films. States the scale before anyone clicks.' },
	{ slug: 'j', name: 'Marquee CTA', note: 'See the work running across the middle of the frame as a band. The loudest invitation of the ten.' },
];
---

<Base title="Home — layout options" noindex bodyClass="page">
	<div class="ho">
		<p class="ho__h">Home page — five directions</p>
		<p class="ho__hint">
			Each one is a real page at full size. Open it, then come back with the browser's
			back button. Your current home is at <a href="/">/</a> for comparison.
		</p>
		<ol class="ho__list">
			{
				options.map((o, i) => (
					<li>
						<a class="ho__row" href={`/home/${o.slug}`}>
							<span class="ho__n">{String(i + 1).padStart(2, '0')}</span>
							<span class="ho__name">{o.name}</span>
						</a>
						<p class="ho__note">{o.note}</p>
					</li>
				))
			}
		</ol>
	</div>
</Base>

<style>
	.ho { max-width: 54rem; margin: 0 auto; padding: clamp(1.5rem, 5vw, 4rem); }
	.ho__h { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.5; margin: 0 0 0.5rem; }
	.ho__hint { font-size: 0.85rem; opacity: 0.45; margin: 0 0 2.6rem; max-width: 50ch; line-height: 1.5; }
	.ho__hint a { color: var(--acid); }
	.ho__list { list-style: none; margin: 0; padding: 0; }
	.ho__list li { border-top: 1px solid rgba(255,255,255,.14); padding: 1.4rem 0; }
	.ho__row { display: flex; align-items: baseline; gap: 1.2rem; color: var(--ink); text-decoration: none; }
	.ho__n { font-size: var(--fs-small); opacity: 0.45; font-variant-numeric: tabular-nums; }
	.ho__name { font-size: clamp(1.4rem, 4vw, 2.6rem); text-transform: uppercase; letter-spacing: var(--track); line-height: 1; transition: color .25s var(--ease-smooth); }
	.ho__row:hover .ho__name { color: var(--acid); }
	.ho__note { margin: 0.7rem 0 0 0; max-width: 56ch; font-size: 0.85rem; line-height: 1.5; opacity: 0.5; }
</style>
