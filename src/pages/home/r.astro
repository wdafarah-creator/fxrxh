---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
import { graphicProjects } from '../../data/graphic.js';

const projects = [...graphicProjects].sort((a, b) => a.title.localeCompare(b.title));
---

<Base title="Home R — scroll through" noindex bodyClass="page hr-page">
	<video class="hr__bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" /><source src="/video/home.mp4" type="video/mp4" />
	</video>
	<div class="film" aria-hidden="true"><div class="film__grain"></div><div class="film__lines"></div></div>

	<header class="hr__bar">
		<Wordmark />
		<nav class="top__nav"><Nav bare /></nav>
	</header>

	<section class="hr__first">
		<p>Farah Awada — multidisciplinary designer</p>
		<span class="hr__cue">Scroll ↓</span>
	</section>

	{projects.map((p, i) => (
		<a class="hr__slab" href={`/work/graphic-design/${p.slug}`}>
			<img src={`/img/work/${p.slug}/${p.cover ?? p.images.find((x) => x.file).file}`} alt="" loading="lazy" />
			<span class="hr__meta">
				<span class="hr__n">{String(i + 1).padStart(2, '0')}</span>
				<span class="hr__t">{p.title}</span>
				<span class="hr__s">{p.scope}</span>
			</span>
		</a>
	))}

	<footer class="hr__end">
		<a href="/work/art-direction-content">22 films →</a>
		<a href="/about">About</a>
	</footer>
</Base>

<style>
	.hr__bg { position: fixed; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
	.hr__bar {
		position: fixed; top: 0; left: 0; right: 0; z-index: 10;
		display: flex; justify-content: space-between; align-items: center;
		padding: var(--pad); mix-blend-mode: difference; pointer-events: none;
	}
	.hr__bar a, .hr__bar button { pointer-events: auto; }
	.hr__first {
		position: relative; z-index: 2; height: 100vh;
		display: grid; align-content: center; justify-items: center; gap: 1.2rem;
		color: var(--ink); font-size: var(--fs-small); letter-spacing: .1em; text-transform: uppercase;
		mix-blend-mode: difference;
	}
	.hr__cue { opacity: .7; }
	.hr__slab {
		position: relative; z-index: 2; display: block; height: 86vh; margin: 0 var(--pad) var(--pad);
		overflow: hidden; border-radius: 2px; color: var(--ink); text-decoration: none; background: #0a0a0a;
	}
	.hr__slab img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.1s var(--ease-smooth); }
	.hr__slab:hover img { transform: scale(1.03); }
	.hr__meta {
		position: absolute; left: clamp(.8rem, 2vw, 1.6rem); bottom: clamp(.8rem, 2vw, 1.6rem);
		display: grid; gap: .15rem; text-transform: uppercase; text-shadow: 0 2px 14px rgba(0,0,0,.8);
	}
	.hr__n { font-size: var(--fs-small); opacity: .7; }
	.hr__t { font-size: clamp(1.3rem, 4vw, 2.8rem); line-height: 1; letter-spacing: var(--track); }
	.hr__s { font-size: var(--fs-small); opacity: .7; }
	.hr__end {
		position: relative; z-index: 2; display: flex; justify-content: space-between;
		padding: 3rem var(--pad) 4rem; font-size: var(--fs-small); text-transform: uppercase;
	}
	.hr__end a { color: var(--ink); }
</style>
