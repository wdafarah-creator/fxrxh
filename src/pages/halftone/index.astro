---
import Base from '../../layouts/Base.astro';

// Scratch page: ten halftone treatments over the real home footage, so the
// choice is made on the actual film rather than on a description. Styles are
// local to this page on purpose — nothing here touches global.css until one
// of them is picked.
const screens = [
	{ id: 'dot', name: 'Newsprint dot', note: 'Even dot grid, 3px pitch, multiplied into the film' },
	{ id: 'line', name: '45° line screen', note: 'Ruled on the diagonal — the engraving version' },
	{ id: 'cross', name: 'Crosshatch', note: 'Two rulings crossed, so it reads as etching' },
	{ id: 'cmyk', name: 'CMYK rosette', note: 'Four screens at print angles — cyan, magenta, yellow, black' },
	{ id: 'true', name: 'True halftone', note: 'Canvas. Dot size follows the brightness of the frame' },
	{ id: 'duo', name: 'Duotone halftone', note: 'Same dots, inked in the pink and the acid' },
	{ id: 'matrix', name: 'Dot matrix', note: 'Lit dots on black — a board rather than a print' },
	{ id: 'crt', name: 'Scanline CRT', note: 'Horizontal ruling with the channels pulled apart' },
	{ id: 'moire', name: 'Moiré drift', note: 'Two screens a degree apart, one slowly turning' },
	{ id: 'stencil', name: 'Stencil', note: 'The film shows only through the holes in a black plate' },
];
---

<Base title="Halftone studies" bodyClass="home" noindex>
	<div class="stage" data-stage>
		<video
			class="bg"
			autoplay
			muted
			loop
			playsinline
			preload="auto"
			poster="/video/home-poster.jpg"
			data-film
		>
			<source src="/video/home.webm" type="video/webm" />
			<source src="/video/home.mp4" type="video/mp4" />
		</video>

		{/* CSS screens — one is lit at a time */}
		<div class="screen screen--dot"></div>
		<div class="screen screen--line"></div>
		<div class="screen screen--cross-a"></div>
		<div class="screen screen--cross-b"></div>
		<div class="screen screen--c"></div>
		<div class="screen screen--m"></div>
		<div class="screen screen--y"></div>
		<div class="screen screen--k"></div>
		<div class="screen screen--matrix"></div>
		<div class="screen screen--scan"></div>
		<div class="screen screen--moire-a"></div>
		<div class="screen screen--moire-b"></div>
		<div class="screen screen--stencil"></div>

		{/* canvas screens */}
		<canvas class="plate" data-plate></canvas>

		<div class="label">
			<span class="label__n" data-n>01</span>
			<span class="label__t" data-t></span>
			<span class="label__d" data-d></span>
		</div>
	</div>

	<nav class="picker">
		{
			screens.map((s, i) => (
				<button type="button" data-pick={s.id} data-i={i}>
					<span>{String(i + 1).padStart(2, '0')}</span>
					{s.name}
				</button>
			))
		}
	</nav>

	<script define:vars={{ screens }}>
		window.__screens = screens;
	</script>
</Base>

<style is:global>
	body.home {
		background: #000;
		overflow: hidden;
	}

	.stage {
		position: fixed;
		inset: 0;
		overflow: hidden;
		background: #000;
	}

	.stage .bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: brightness(1.28) contrast(1.06) saturate(1.05);
	}

	/* canvas treatments hide the film and paint their own */
	.stage.is-plate .bg {
		opacity: 0;
	}

	.plate {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: none;
	}

	.stage.is-plate .plate {
		display: block;
	}

	.screen {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0;
	}

	.stage[data-on='dot'] .screen--dot,
	.stage[data-on='line'] .screen--line,
	.stage[data-on='cross'] .screen--cross-a,
	.stage[data-on='cross'] .screen--cross-b,
	.stage[data-on='cmyk'] .screen--c,
	.stage[data-on='cmyk'] .screen--m,
	.stage[data-on='cmyk'] .screen--y,
	.stage[data-on='cmyk'] .screen--k,
	.stage[data-on='matrix'] .screen--matrix,
	.stage[data-on='crt'] .screen--scan,
	.stage[data-on='moire'] .screen--moire-a,
	.stage[data-on='moire'] .screen--moire-b,
	.stage[data-on='stencil'] .screen--stencil {
		opacity: 1;
	}

	/* 01 — an even dot grid. 3px pitch, so the dots are below the eye's
	   ability to resolve them individually and read as tone. */
	.screen--dot {
		background-image: radial-gradient(circle at center, rgba(0, 0, 0, 0.55) 0.6px, transparent 0.7px);
		background-size: 3px 3px;
		mix-blend-mode: multiply;
	}

	/* 02 — the same ruling turned 45°, which is where an engraver puts it */
	.screen--line {
		background-image: repeating-linear-gradient(
			45deg,
			rgba(0, 0, 0, 0.45) 0px,
			rgba(0, 0, 0, 0.45) 0.6px,
			transparent 0.6px,
			transparent 3px
		);
		mix-blend-mode: multiply;
	}

	/* 03 — two rulings crossed */
	.screen--cross-a {
		background-image: repeating-linear-gradient(
			45deg,
			rgba(0, 0, 0, 0.38) 0px,
			rgba(0, 0, 0, 0.38) 0.5px,
			transparent 0.5px,
			transparent 4px
		);
		mix-blend-mode: multiply;
	}

	.screen--cross-b {
		background-image: repeating-linear-gradient(
			-45deg,
			rgba(0, 0, 0, 0.38) 0px,
			rgba(0, 0, 0, 0.38) 0.5px,
			transparent 0.5px,
			transparent 4px
		);
		mix-blend-mode: multiply;
	}

	/* 04 — four screens at the angles a press would use: 15, 75, 0, 45.
	   Where they overlap they build the rosette you see in cheap print. */
	.screen--c,
	.screen--m,
	.screen--y,
	.screen--k {
		background-size: 4px 4px;
		mix-blend-mode: multiply;
	}

	.screen--c {
		background-image: radial-gradient(circle at center, rgba(0, 190, 220, 0.5) 0.8px, transparent 0.9px);
		rotate: 15deg;
		scale: 1.5;
	}

	.screen--m {
		background-image: radial-gradient(circle at center, rgba(235, 0, 140, 0.5) 0.8px, transparent 0.9px);
		rotate: 75deg;
		scale: 1.5;
	}

	.screen--y {
		background-image: radial-gradient(circle at center, rgba(250, 220, 0, 0.45) 0.8px, transparent 0.9px);
		scale: 1.5;
	}

	.screen--k {
		background-image: radial-gradient(circle at center, rgba(0, 0, 0, 0.45) 0.7px, transparent 0.8px);
		rotate: 45deg;
		scale: 1.5;
	}

	/* 07 — lit dots rather than printed ones: the gaps go black and the dots
	   carry the picture, so it reads as a panel, not a page. */
	.screen--matrix {
		background-image: radial-gradient(circle at center, transparent 1.1px, #000 1.3px);
		background-size: 4px 4px;
	}

	/* 08 — a horizontal ruling with the channels pulled a hair apart */
	.screen--scan {
		background-image: repeating-linear-gradient(
			0deg,
			rgba(0, 0, 0, 0.5) 0px,
			rgba(0, 0, 0, 0.5) 1px,
			transparent 1px,
			transparent 3px
		);
		box-shadow: inset 0 0 160px rgba(0, 0, 0, 0.55);
	}

	.stage[data-on='crt'] .bg {
		filter: brightness(1.3) contrast(1.12) saturate(1.5);
		text-shadow: none;
	}

	/* 09 — two screens one degree apart. The interference pattern crawls as
	   the top one turns. */
	.screen--moire-a,
	.screen--moire-b {
		background-image: radial-gradient(circle at center, rgba(0, 0, 0, 0.42) 0.7px, transparent 0.8px);
		background-size: 4px 4px;
		mix-blend-mode: multiply;
		scale: 1.6;
	}

	.screen--moire-b {
		animation: turn 40s linear infinite;
	}

	@keyframes turn {
		to {
			rotate: 360deg;
		}
	}

	/* 10 — a black plate with the dots punched out of it */
	.screen--stencil {
		background-color: #000;
		-webkit-mask-image: radial-gradient(circle at center, #000 1.3px, transparent 1.5px);
		mask-image: radial-gradient(circle at center, #000 1.3px, transparent 1.5px);
		-webkit-mask-size: 4px 4px;
		mask-size: 4px 4px;
		-webkit-mask-composite: xor;
		mask-composite: exclude;
	}

	.stage[data-on='stencil'] {
		background: #000;
	}

	/* --- chrome ----------------------------------------------------------- */

	.label {
		position: absolute;
		left: clamp(1rem, 3vw, 2rem);
		top: clamp(1rem, 3vw, 2rem);
		z-index: 5;
		display: grid;
		gap: 0.2rem;
		color: #fff;
		text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9), 0 0 2px rgba(0, 0, 0, 0.9);
		text-transform: uppercase;
		letter-spacing: var(--track-small);
		font-size: var(--fs-small);
		pointer-events: none;
	}

	.label__t {
		font-size: clamp(1rem, 3vw, 1.9rem);
		letter-spacing: var(--track);
	}

	.label__d {
		opacity: 0.65;
		text-transform: none;
		letter-spacing: 0;
		max-width: 34ch;
	}

	.picker {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 6;
		display: flex;
		flex-wrap: wrap;
		gap: 1px;
		padding: 1px;
		background: rgba(255, 255, 255, 0.12);
	}

	.picker button {
		flex: 1 1 auto;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 0.9rem;
		border: 0;
		background: #000;
		color: #fff;
		font: inherit;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: var(--track-small);
		cursor: pointer;
		white-space: nowrap;
	}

	.picker button span {
		opacity: 0.4;
		font-variant-numeric: tabular-nums;
	}

	.picker button:hover {
		background: #161616;
	}

	.picker button[aria-current='true'] {
		background: #fff;
		color: #000;
	}
</style>

<script>
	const stage = document.querySelector('[data-stage]');
	const film = document.querySelector('[data-film]');
	const plate = document.querySelector('[data-plate]');
	const ctx = plate.getContext('2d', { alpha: false });
	const screens = window.__screens;

	const field = {
		n: document.querySelector('[data-n]'),
		t: document.querySelector('[data-t]'),
		d: document.querySelector('[data-d]'),
	};

	// The two canvas treatments sample the frame at a fraction of its size —
	// one reading per cell is all a halftone needs — then draw the dots back
	// at full size.
	const sample = document.createElement('canvas');
	const sctx = sample.getContext('2d', { willReadFrequently: true });

	const PLATE = { true: { cell: 3.4, angle: 45 }, duo: { cell: 4.2, angle: 15 } };

	let mode = 'dot';
	let raf = 0;

	const size = () => {
		const r = Math.min(devicePixelRatio || 1, 2);
		plate.width = Math.round(innerWidth * r);
		plate.height = Math.round(innerHeight * r);
	};
	size();
	addEventListener('resize', size);

	// How the film is cropped into the frame, so the sampled pixels line up
	// with what the cover-fitted video actually shows.
	const crop = () => {
		const vw = film.videoWidth || 16;
		const vh = film.videoHeight || 9;
		const s = Math.max(plate.width / vw, plate.height / vh);
		const w = vw * s;
		const h = vh * s;
		return { x: (plate.width - w) / 2, y: (plate.height - h) / 2, w, h };
	};

	const draw = () => {
		raf = requestAnimationFrame(draw);
		if (!PLATE[mode] || film.readyState < 2) return;

		const { cell, angle } = PLATE[mode];
		const r = Math.min(devicePixelRatio || 1, 2);
		const px = cell * r;
		const c = crop();

		// one sample per cell
		const sw = Math.max(1, Math.ceil(plate.width / px));
		const sh = Math.max(1, Math.ceil(plate.height / px));
		if (sample.width !== sw || sample.height !== sh) {
			sample.width = sw;
			sample.height = sh;
		}
		sctx.drawImage(
			film,
			(-c.x / c.w) * film.videoWidth,
			(-c.y / c.h) * film.videoHeight,
			(plate.width / c.w) * film.videoWidth,
			(plate.height / c.h) * film.videoHeight,
			0,
			0,
			sw,
			sh
		);
		const data = sctx.getImageData(0, 0, sw, sh).data;

		ctx.fillStyle = mode === 'duo' ? '#0a0010' : '#000';
		ctx.fillRect(0, 0, plate.width, plate.height);

		// The screen is turned, the way a real one is, so the grid never lines
		// up with the pixels and never beats against the footage.
		const a = (angle * Math.PI) / 180;
		const cos = Math.cos(a);
		const sin = Math.sin(a);
		const reach = Math.ceil((plate.width + plate.height) / px);
		const max = (px / 2) * 1.35;

		ctx.save();
		for (let j = -reach; j < reach; j++) {
			for (let i = -reach; i < reach; i++) {
				// lattice point, rotated into the frame
				const x = (i * cos - j * sin) * px + plate.width / 2;
				const y = (i * sin + j * cos) * px + plate.height / 2;
				if (x < -px || y < -px || x > plate.width + px || y > plate.height + px) continue;

				const sx = Math.min(sw - 1, Math.max(0, Math.round(x / px)));
				const sy = Math.min(sh - 1, Math.max(0, Math.round(y / px)));
				const k = (sy * sw + sx) * 4;
				const lum = (data[k] * 0.299 + data[k + 1] * 0.587 + data[k + 2] * 0.114) / 255;
				if (lum < 0.03) continue;

				// area, not radius, carries the tone — hence the square root
				const rad = Math.sqrt(lum) * max;

				if (mode === 'duo') {
					// two inks, split by tone: the acid holds the highlights,
					// the pink everything under them
					ctx.fillStyle = lum > 0.62 ? '#e5ff76' : '#ff66ff';
				} else {
					ctx.fillStyle = '#fff';
				}
				ctx.beginPath();
				ctx.arc(x, y, rad, 0, 6.2832);
				ctx.fill();
			}
		}
		ctx.restore();
	};

	const set = (id) => {
		mode = id;
		const i = screens.findIndex((s) => s.id === id);
		const s = screens[i];
		stage.dataset.on = id;
		stage.classList.toggle('is-plate', Boolean(PLATE[id]));
		field.n.textContent = String(i + 1).padStart(2, '0');
		field.t.textContent = s.name;
		field.d.textContent = s.note;
		document.querySelectorAll('[data-pick]').forEach((b) =>
			b.setAttribute('aria-current', String(b.dataset.pick === id))
		);
	};

	document.querySelectorAll('[data-pick]').forEach((b) =>
		b.addEventListener('click', () => set(b.dataset.pick))
	);

	addEventListener('keydown', (e) => {
		const n = Number(e.key);
		if (n >= 1 && n <= 9) set(screens[n - 1].id);
		if (e.key === '0') set(screens[9].id);
		if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
			const i = screens.findIndex((s) => s.id === mode);
			const d = e.key === 'ArrowRight' ? 1 : -1;
			set(screens[(i + d + screens.length) % screens.length].id);
		}
	});

	set('dot');
	draw();
</script>
