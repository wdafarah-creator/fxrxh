---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
---

<Base title="Cursor E — comet" noindex bodyClass="home">
	<video class="bg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" /><source src="/video/home.mp4" type="video/mp4" />
	</video>
	<div class="fx fx--comet">
		<span data-hole style="--r:13rem"></span>
		<span data-hole style="--r:10rem"></span>
		<span data-hole style="--r:7rem"></span>
		<span data-hole style="--r:4.5rem"></span>
	</div>
	<div class="overlay cur">
		<div class="top"><Wordmark /><nav class="top__nav"><Nav bare /></nav></div>
		<div class="cur__mid"><a href="/work">See the work</a></div>
		<div class="cur__foot"><a href="/about">About</a><span>A trailing reveal</span></div>
	</div>
</Base>

<script>
	const holes = [...document.querySelectorAll('[data-hole]')];
	if (holes.length && matchMedia('(hover: hover)').matches) {
		const pts = holes.map(() => ({ x: innerWidth / 2, y: innerHeight / 2 }));
		let tx = innerWidth / 2, ty = innerHeight / 2;
		addEventListener('mousemove', (e) => { tx = e.clientX; ty = e.clientY; }, { passive: true });
		const step = () => {
			pts.forEach((p, i) => {
				const prev = i === 0 ? { x: tx, y: ty } : pts[i - 1];
				p.x += (prev.x - p.x) * 0.26;
				p.y += (prev.y - p.y) * 0.26;
				holes[i].style.setProperty('--x', p.x + 'px');
				holes[i].style.setProperty('--y', p.y + 'px');
			});
			requestAnimationFrame(step);
		};
		step();
	}
</script>

<style is:global>
	.cur { z-index: 6; }
	.cur__mid { display: grid; place-content: center; }
	.cur__mid a {
		color: var(--ink); text-decoration: none; pointer-events: auto;
		font-size: clamp(1.3rem, 5vw, 3.6rem); letter-spacing: -.03em; text-transform: uppercase;
	}
	.cur__foot { align-self: end; display: flex; justify-content: space-between; font-size: var(--fs-small); }
	.cur__foot a { color: var(--ink); pointer-events: auto; }

	.fx--comet { position: fixed; inset: 0; z-index: 3; pointer-events: none; }
	.fx--comet span {
		position: absolute; inset: 0; display: block; background: #000;
		--x: 50vw; --y: 50vh;
		-webkit-mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), transparent 0%, transparent 40%, #000 100%);
		mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), transparent 0%, transparent 40%, #000 100%);
	}

</style>
