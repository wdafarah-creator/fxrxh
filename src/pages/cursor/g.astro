---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Wordmark from '../../components/Wordmark.astro';
---

<Base title="Cursor G — inverted field" noindex bodyClass="home">
	<video class="bg fx--allneg" autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.mp4" type="video/mp4" />
	</video>
	<div class="fx fx--g" data-fx>
		<video autoplay muted loop playsinline preload="metadata" poster="/video/home-poster.jpg">
			<source src="/video/home.mp4" type="video/mp4" />
		</video>
	</div>
	<div class="overlay cur">
		<div class="top"><Wordmark /><nav class="top__nav"><Nav bare /></nav></div>
		<div class="cur__mid"><a href="/work">See the work</a></div>
		<div class="cur__foot"><a href="/about">About</a><span>The page is the negative</span></div>
	</div>
</Base>

<script>
	const el = document.querySelector('[data-fx]');
	if (el && matchMedia('(hover: hover)').matches) {
		let x = innerWidth / 2, y = innerHeight / 2, raf = null;
		const paint = () => { raf = null; el.style.setProperty('--x', x + 'px'); el.style.setProperty('--y', y + 'px'); };
		addEventListener('mousemove', (e) => { x = e.clientX; y = e.clientY; if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
		paint();
	}
</script>

<style is:global>
	.cur { z-index: 6; }
	.cur__mid { display: grid; place-content: center; }
	.cur__mid a {
		color: var(--ink); text-decoration: none; pointer-events: auto;
		font-size: clamp(1.3rem, 5vw, 3.6rem); letter-spacing: -.03em; text-transform: uppercase;
	}
	.cur__foot { align-self: end; display: flex; justify-content: space-between; font-size: var(--fs-small); }
	.cur__foot a { color: var(--ink); pointer-events: auto; }

	.fx--allneg { filter: invert(1) hue-rotate(180deg); }
	.fx--g {
		position: fixed; inset: 0; z-index: 3; pointer-events: none;
		--x: 50vw; --y: 50vh;
		-webkit-mask-image: radial-gradient(circle 12rem at var(--x) var(--y), #000 0%, #000 50%, transparent 100%);
		mask-image: radial-gradient(circle 12rem at var(--x) var(--y), #000 0%, #000 50%, transparent 100%);
	}
	.fx--g video { width: 100%; height: 100%; object-fit: cover; }

</style>
