---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { artDirection } from '../../data/work.js';
---

<Base
	title="Art Direction & Content — Video & AI-Generated Work | Farah Awada"
	description="Art direction and content by Farah Awada: event and brand films shot on Sony A7 III, motion design, and AI-generated and CGI video, directed and edited in-house."
>
	<h1 class="sr-only">Art direction &amp; content — video, motion and AI-generated work</h1>
	<Nav back="/work" next="/work/graphic-design" nextLabel="Graphic Design" />

	<div class="sheet">
		{
			artDirection.map((item, i) => (
				<figure class={`sheet__cell${item.portrait ? ' is-portrait' : ''}`}>
					<button
						class="sheet__open"
						type="button"
						data-open={`/video/work/${item.slug}.mp4`}
						data-caption={item.title}
						data-label={item.label}
						data-dur={item.dur}
						data-index={`${String(i + 1).padStart(2, '0')} / ${String(artDirection.length).padStart(2, '0')}`}
						aria-label={`Play ${item.title} full screen`}
					/>
					<video
						class="sheet__video"
						data-src={`/video/work/${item.slug}.mp4`}
						poster={`/video/work/posters/${item.slug}.jpg`}
						width={item.w}
						height={item.h}
						muted
						loop
						playsinline
						preload="none"
					/>
					<figcaption>
						<span class="sheet__n">{String(i + 1).padStart(2, '0')}</span>
						<span class="sheet__t">{item.title}</span>
						<span class="sheet__d">{item.dur}</span>
						<span class="sheet__l">{item.label}</span>
					</figcaption>
				</figure>
			))
		}
	</div>
	{/* One player, reused for whichever tile is opened. Controls are drawn
	    here rather than by the browser, and difference-blended so they read
	    on any frame without a plate behind them. */}
	<dialog class="lb" id="lightbox" aria-label="Player">
		<div class="lb__stage">
			<video class="lb__video" loop playsinline></video>

			<button class="lb__tap" type="button" data-tap aria-label="Play or pause"></button>

			<button class="lb__step lb__step--prev" type="button" data-prev aria-label="Previous">
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 2 L4 8 L10 14" /></svg>
			</button>
			<button class="lb__step lb__step--next" type="button" data-next aria-label="Next">
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2 L12 8 L6 14" /></svg>
			</button>

			<button class="lb__close" type="button" data-close aria-label="Close">
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3 L13 13 M13 3 L3 13" /></svg>
			</button>

			<div class="lb__hud">
				<span class="lb__t" data-lb-title></span>
				<span class="lb__l" data-lb-label></span>
				<span class="lb__i" data-lb-index></span>
				<span class="lb__time" data-lb-time>0:00</span>
				<button class="lb__scrub" type="button" data-scrub aria-label="Seek">
					<span class="lb__prog" data-prog></span>
				</button>
			</div>
		</div>
	</dialog>
</Base>

<script>
	const videos = [...document.querySelectorAll('.sheet__video')];

	const load = (v) => {
		if (!v.src) v.src = v.dataset.src;
	};

	// Only what is on screen loads and plays; everything else is released so
	// twenty-two clips never sit in memory at once.
	const play = new IntersectionObserver(
		(entries) =>
			entries.forEach((e) => {
				const v = e.target;
				if (e.isIntersecting) {
					load(v);
					v.play().catch(() => {});
				} else {
					v.pause();
				}
			}),
		{ threshold: 0.2 }
	);

	const release = new IntersectionObserver(
		(entries) =>
			entries.forEach((e) => {
				if (e.isIntersecting) return;
				const v = e.target;
				if (!v.src) return;
				v.pause();
				v.removeAttribute('src');
				v.load();
			}),
		{ rootMargin: '150% 0px' }
	);

	videos.forEach((v) => {
		play.observe(v);
		release.observe(v);
	});

	// --- player --------------------------------------------------------------
	const box = document.getElementById('lightbox');
	const player = box.querySelector('.lb__video');
	const prog = box.querySelector('[data-prog]');
	const scrub = box.querySelector('[data-scrub]');
	const clips = [...document.querySelectorAll('[data-open]')].map((b) => b.dataset);
	const field = {
		title: box.querySelector('[data-lb-title]'),
		label: box.querySelector('[data-lb-label]'),
		index: box.querySelector('[data-lb-index]'),
		time: box.querySelector('[data-lb-time]'),
	};

	let at = 0;

	const clock = (s) => {
		if (!isFinite(s)) return '0:00';
		const m = Math.floor(s / 60);
		return `${m}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
	};

	const open = (i) => {
		at = (i + clips.length) % clips.length;
		const c = clips[at];
		player.src = c.open;
		field.title.textContent = c.caption ?? '';
		field.label.textContent = c.label ?? '';
		field.index.textContent = c.index ?? '';
		field.time.textContent = '0:00';
		prog.style.transform = 'scaleX(0)';
		if (!box.open) box.showModal();
		player.play().catch(() => {});
	};

	const close = () => {
		player.pause();
		player.removeAttribute('src');
		player.load();
		if (box.open) box.close();
	};

	document.querySelectorAll('[data-open]').forEach((btn, i) =>
		btn.addEventListener('click', () => open(i))
	);

	box.querySelector('[data-prev]').addEventListener('click', () => open(at - 1));
	box.querySelector('[data-next]').addEventListener('click', () => open(at + 1));
	box.querySelector('[data-close]').addEventListener('click', close);
	box.addEventListener('close', close);

	box.querySelector('[data-tap]').addEventListener('click', () => {
		if (player.paused) player.play().catch(() => {});
		else player.pause();
		box.classList.toggle('is-paused', player.paused);
	});

	player.addEventListener('timeupdate', () => {
		const d = player.duration;
		if (!isFinite(d) || !d) return;
		prog.style.transform = `scaleX(${player.currentTime / d})`;
		field.time.textContent = `${clock(player.currentTime)} / ${clock(d)}`;
	});

	scrub.addEventListener('click', (e) => {
		const r = scrub.getBoundingClientRect();
		const d = player.duration;
		if (isFinite(d) && d) player.currentTime = ((e.clientX - r.left) / r.width) * d;
	});

	addEventListener('keydown', (e) => {
		if (!box.open) return;
		if (e.key === 'ArrowRight') { e.preventDefault(); open(at + 1); }
		if (e.key === 'ArrowLeft') { e.preventDefault(); open(at - 1); }
		if (e.key === ' ') { e.preventDefault(); box.querySelector('[data-tap]').click(); }
	});
</script>
