---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { artDirection } from '../../data/work.js';
---

<Base
	title="Art Direction & Content — Video & AI-Generated Work | Farah Awada"
	description="Art direction and content by Farah Awada: event and brand films shot on Sony A7 III, motion design, and AI-generated and CGI video, directed and edited in-house."
>
	<h1 class="sr-only">Art direction &amp; content — video, motion and AI-generated work</h1>
	<Nav back="/work" next="/work/graphic-design" nextLabel="Graphic Design" />

	<div class="sheet">
		{
			artDirection.map((item, i) => (
				<figure class={`sheet__cell${item.portrait ? ' is-portrait' : ''}`}>
					<button
						class="sheet__open"
						type="button"
						data-open={`/video/work/${item.slug}.mp4`}
						data-caption={item.title}
						data-label={item.label}
						data-dur={item.dur}
						data-index={`${String(i + 1).padStart(2, '0')} / ${String(artDirection.length).padStart(2, '0')}`}
						aria-label={`Play ${item.title} full screen`}
					/>
					<video
						class="sheet__video"
						data-src={`/video/work/${item.slug}.mp4`}
						poster={`/video/work/posters/${item.slug}.jpg`}
						width={item.w}
						height={item.h}
						muted
						loop
						playsinline
						preload="none"
					/>
					<figcaption>
						<span class="sheet__n">{String(i + 1).padStart(2, '0')}</span>
						<span class="sheet__t">{item.title}</span>
						<span class="sheet__d">{item.dur}</span>
						<span class="sheet__l">{item.label}</span>
					</figcaption>
				</figure>
			))
		}
	</div>
	{/* One player, reused for whichever tile is opened. */}
	<dialog class="lightbox" id="lightbox" aria-label="Full screen player">
		<div class="lightbox__stage">
			<video class="lightbox__video" controls loop playsinline></video>
		</div>

		{/* A row of its own beneath the film, so the browser's controls and
		    the close button can never sit on top of it. */}
		<footer class="lightbox__info">
			<span class="lightbox__text">
				<span class="lightbox__t" data-lb-title></span>
				<span class="lightbox__l" data-lb-label></span>
			</span>
			<span class="lightbox__meta">
				<span class="lightbox__i" data-lb-index></span>
				<span class="lightbox__d" data-lb-dur></span>
			</span>
			<button class="lightbox__close" type="button">Close</button>
		</footer>
	</dialog>
</Base>

<script>
	const videos = [...document.querySelectorAll('.sheet__video')];

	const load = (v) => {
		if (!v.src) v.src = v.dataset.src;
	};

	// Only what is on screen loads and plays; everything else is released so
	// twenty-two clips never sit in memory at once.
	const play = new IntersectionObserver(
		(entries) =>
			entries.forEach((e) => {
				const v = e.target;
				if (e.isIntersecting) {
					load(v);
					v.play().catch(() => {});
				} else {
					v.pause();
				}
			}),
		{ threshold: 0.2 }
	);

	const release = new IntersectionObserver(
		(entries) =>
			entries.forEach((e) => {
				if (e.isIntersecting) return;
				const v = e.target;
				if (!v.src) return;
				v.pause();
				v.removeAttribute('src');
				v.load();
			}),
		{ rootMargin: '150% 0px' }
	);

	videos.forEach((v) => {
		play.observe(v);
		release.observe(v);
	});

	// --- full screen player -------------------------------------------------
	const box = document.getElementById('lightbox');
	const player = box.querySelector('.lightbox__video');
	const fields = {
		title: box.querySelector('[data-lb-title]'),
		label: box.querySelector('[data-lb-label]'),
		dur: box.querySelector('[data-lb-dur]'),
		index: box.querySelector('[data-lb-index]'),
	};

	const close = () => {
		player.pause();
		player.removeAttribute('src');
		player.load();
		if (box.open) box.close();
	};

	document.querySelectorAll('[data-open]').forEach((btn) => {
		btn.addEventListener('click', () => {
			player.src = btn.dataset.open;
			fields.title.textContent = btn.dataset.caption ?? '';
			fields.label.textContent = btn.dataset.label ?? '';
			fields.dur.textContent = btn.dataset.dur ?? '';
			fields.index.textContent = btn.dataset.index ?? '';
			box.showModal();
			player.play().catch(() => {});
		});
	});

	box.querySelector('.lightbox__close').addEventListener('click', close);
	box.addEventListener('close', close);
	// clicking the backdrop, i.e. outside the player itself
	box.addEventListener('click', (e) => {
		if (e.target === box) close();
	});
</script>
