---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { graphicProjects } from '../../../data/graphic.js';

// The list reads alphabetically — the numerals are a graphic device, not a
// ranking, so they follow the sorted order rather than the data order.
const projects = [...graphicProjects].sort((a, b) => a.title.localeCompare(b.title));

// "Branding \u00b7 Packaging" is a spec line; "Branding, Packaging" is a
// phrase. On a contents page it wants to be the second one.
const soften = (scope) =>
	scope
		.split(' \u00b7 ')
		.map((word) => word.charAt(0) + word.slice(1).toLowerCase())
		.join(', ');
---

<Base
	title="Graphic Design — Brand Identity, Packaging & Type | Farah Awada"
	description="Graphic design work by Farah Awada: brand identities, packaging, editorial, poster design and original typefaces."
	bodyClass="page has-fog"
>
	<video class="bg bg--fog" autoplay muted loop playsinline disablepictureinpicture controlslist="nodownload noplaybackrate noremoteplayback" preload="metadata" poster="/video/home-poster.jpg">
		<source src="/video/home.webm" type="video/webm" />
		<source src="/video/home.mp4" type="video/mp4" />
	</video>
	<h1 class="sr-only">Graphic design — brand identity, packaging, editorial and type</h1>
	<div class="fog" aria-hidden="true"></div>

	<Nav back="/work" next="/work/art-direction-content" nextLabel="Art Direction & Content" />

	<ol class="index-list">
		{
			projects.map((p) => (
				<li>
					<a class="row" href={`/work/graphic-design/${p.slug}`}>
						<span class="row__title">{p.title}</span>
						<span class="row__dots" aria-hidden="true"></span>
						<span class="row__scope">{soften(p.scope)}</span>
					</a>
				</li>
			))
		}
	</ol>

	<Footer
		next={{ href: '/work/art-direction-content', title: 'Art Direction & Content', scope: 'Videography, motion and AI-generated work' }}
		indexHref="/work"
		indexLabel="All work"
		kicker="Next section"
	/>
</Base>
