---
// Inline marks for the two contact links. Stroke-based so they take
// currentColor and sit correctly inside a difference-blended bar.
interface Props {
	name: 'instagram' | 'email';
}
const { name } = Astro.props;
---

{
	name === 'instagram' && (
		<svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
			<rect x="3" y="3" width="18" height="18" rx="5" />
			<circle cx="12" cy="12" r="4" />
			<circle class="ico__dot" cx="17.2" cy="6.8" r="1.1" />
		</svg>
	)
}

{
	name === 'email' && (
		<svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
			<rect x="2.5" y="5" width="19" height="14" rx="2" />
			<path d="M3 7 L12 13.5 L21 7" />
		</svg>
	)
}
