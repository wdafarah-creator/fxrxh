																																																			---
// Desktop only, and only where there is a real pointer. One coloured dot,
// locked to the pointer: a trailing ring reads as lag once the thing it
// trails is solid rather than a hairline.
---

<div class="cur" aria-hidden="true">
	<span class="cur__dot" data-cur-dot></span>
</div>

<script>
	const fine = matchMedia('(hover: hover) and (pointer: fine)');
	if (fine.matches) {
		const dot = document.querySelector('[data-cur-dot]');

		document.documentElement.classList.add('has-cursor');

		let x = innerWidth / 2;
		let y = innerHeight / 2;
		let raf = 0;

		const draw = () => {
			raf = 0;
			dot.style.transform = `translate3d(${x}px, ${y}px, 0)`;
		};

		const tick = () => {
			if (!raf) raf = requestAnimationFrame(draw);
		};

		addEventListener(
			'pointermove',
			(e) => {
				if (e.pointerType !== 'mouse') return;
				x = e.clientX;
				y = e.clientY;
				document.documentElement.classList.add('cursor-on');
				tick();
			},
			{ passive: true }
		);

		// Anything you can act on opens the dot out; over the two mockups it
		// tightens instead, because there it means grip rather than click.
		const TARGET = 'a, button, .row, .sheet__open, [role="button"]';
		const DRAG = '.laptop__screen, .phone__screen';

		addEventListener(
			'pointerover',
			(e) => {
				if (!e.target.closest) return;
				document.documentElement.classList.toggle('cursor-live', !!e.target.closest(TARGET));
				document.documentElement.classList.toggle('cursor-drag', !!e.target.closest(DRAG));
			},
			{ passive: true }
		);

		addEventListener('pointerdown', () => document.documentElement.classList.add('cursor-down'));
		addEventListener('pointerup', () => document.documentElement.classList.remove('cursor-down'));

		// Only a real exit from the page hides it. pointerleave on document
		// also fires as the pointer passes between elements in some engines,
		// which left the cursor invisible while the dot was still tracking.
		document.documentElement.addEventListener('mouseleave', () =>
			document.documentElement.classList.remove('cursor-on')
		);
		document.documentElement.addEventListener('mouseenter', () =>
			document.documentElement.classList.add('cursor-on')
		);
	}
</script>
