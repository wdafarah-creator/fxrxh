---
/* Rates & packages, set in the About page's own voice: uppercase, one face,
   pills for controls, the hot pink for prices and anything chosen.
   Tapping a line adds it to a running estimate that can be emailed straight
   to Farah. EUR is the base; AED figures are rounded, not converted live. */
const packages = [
	{ id: 'p1', name: 'Visual Identity & Brand World', for: 'Fashion · Beauty · Wellness · Startups', inc: 'Creative direction & moodboard / Logo or wordmark / Colour & type system / 4–6 brand applications / Guidelines', eur: 2000, aed: 8500 },
	{ id: 'p2', name: 'Campaign Art Direction', for: 'Luxury · Fashion · Lifestyle · Beauty', inc: 'Campaign concept / References & moodboard / Art direction & storytelling / 3–5 key assets / Channel adaptations', eur: 2500, aed: 10500 },
	{ id: 'p3', name: 'AI Visual Campaign', for: 'Product brands · Digital campaigns', inc: 'Concept & visual direction / 5 finished AI CGI visuals / Refinement & compositing / 2 revision rounds', eur: 1500, aed: 6300 },
	{ id: 'p4', name: 'Hospitality & Lifestyle Launch', for: 'Restaurants · Hotels · Bars · Wellness', inc: 'Launch concept / Menu or print collateral / 5 social assets / Event artwork / Digital adaptations', eur: 2500, aed: 10500 },
	{ id: 'p5', name: 'Music & Cultural Campaign', for: 'Artists · Labels · Festivals · Culture', inc: 'Event or release concept / Key artwork / 3–5 promo adaptations / Social formats', eur: 1200, aed: 5000 },
];
const services = [
	{ title: 'Branding', unit: 'per project', items: [
		{ id: 's1', name: 'Logo Essentials', d: 'Logo, colours, type, mini brand guide', eur: 900, aed: 3800 },
		{ id: 's2', name: 'Brand Identity', d: '+ packaging, stickers, launch posts, guidelines', eur: 2000, aed: 8500 },
		{ id: 's3', name: 'Brand + Website', d: 'Brand Identity + website, up to 5 pages', eur: 3500, aed: 14500 },
	]},
	{ title: 'Websites', unit: 'design + build', items: [
		{ id: 'w1', name: 'Landing Page', d: 'One-page site, mobile-ready, live on your domain', eur: 900, aed: 3800 },
		{ id: 'w2', name: 'Website', d: 'Up to 5 pages, custom design, basic SEO', eur: 1800, aed: 7600 },
		{ id: 'w3', name: 'Custom Website', d: 'Motion, video, shop or CMS · from', eur: 3000, aed: 12600 },
	]},
	{ title: 'Social Media', unit: 'monthly', items: [
		{ id: 's4', name: 'Starter', d: '8 designed posts', eur: 450, aed: 1900, mo: true },
		{ id: 's5', name: 'Growth', d: '12 posts + 4 stories', eur: 750, aed: 3200, mo: true },
		{ id: 's6', name: 'Full', d: '12 posts + 4 reels + content plan', eur: 1500, aed: 6300, mo: true },
	]},
	{ title: 'AI CGI & Video', unit: 'per piece', items: [
		{ id: 's7', name: 'AI CGI Visual', d: 'Photoreal product or fashion image', eur: 200, aed: 850 },
		{ id: 's8', name: 'AI Product Video', d: '10–15 sec, ready for social', eur: 500, aed: 2100 },
		{ id: 's9', name: 'AI Campaign Video', d: 'Up to 30 sec, concept to final edit', eur: 900, aed: 3800 },
	]},
	{ title: 'Merch & Stickers', unit: 'per project', items: [
		{ id: 's14', name: 'Sticker Pack', d: '6 custom stickers, print-ready files', eur: 350, aed: 1500 },
		{ id: 's15', name: 'Merch Design', d: 'One graphic for a tee, tote or hoodie + mockups', eur: 400, aed: 1700 },
		{ id: 's16', name: 'Merch Capsule', d: '3–5 pieces in one collection, print-ready + mockups', eur: 1200, aed: 5000 },
	]},
	{ title: 'Photo & Film', unit: 'per day / edit', items: [
		{ id: 's10', name: 'Half-Day Shoot', d: 'Up to 4 hours', eur: 350, aed: 1500 },
		{ id: 's11', name: 'Full-Day Shoot', d: 'Up to 8 hours', eur: 600, aed: 2500 },
		{ id: 's12', name: 'Reel Edit + Colour Grade', d: 'Per video', eur: 200, aed: 850 },
		{ id: 's13', name: 'Creative Direction', d: 'Day rate, concept to on-set', eur: 600, aed: 2500 },
	]},
];
const partnerships = [
	{ id: 'm1', name: 'Essential', d: 'Ongoing design support · up to 12 h', eur: 1300, aed: 5500, mo: true },
	{ id: 'm2', name: 'Creative', d: 'Design + direction · up to 24 h', eur: 2200, aed: 9200, mo: true },
	{ id: 'm3', name: 'Extended', d: 'Your outsourced creative · up to 40 h', eur: 3500, aed: 14700, mo: true },
];
const fmt = (n: number) => n.toLocaleString('en-US');
---

<section class="rates" id="rates">
	<button class="rates__open" type="button" aria-expanded="false" aria-controls="rates-panel">
		<span>Rates &amp; packages <em>— take a look</em></span>
		<svg class="rates__chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2 L8 13 M3 8.5 L8 14 L13 8.5" /></svg>
	</button>

	<div class="rates__panel" id="rates-panel" hidden>
	<div class="rates__head">
		<p class="rates__tap"><span class="rates__dot" aria-hidden="true"></span><span><em>Tap</em> the services you need to build your estimate</span></p>
		<div class="rates__cur" role="group" aria-label="Currency">
			<button class="btn is-on" type="button" data-cur="eur" aria-pressed="true">EUR €</button>
			<button class="btn" type="button" data-cur="aed" aria-pressed="false">AED</button>
		</div>
	</div>
	<p class="rates__hint">Starting prices · Your total appears at the bottom of the screen</p>

	<div class="rates__group">
		<h3 class="rates__label">Packages</h3>
		{packages.map((p, i) => (
			<button class="rate rate--pkg" type="button" data-id={p.id} data-name={p.name} data-eur={p.eur} data-aed={p.aed} aria-pressed="false">
				<span class="rate__no">({String(i + 1).padStart(2, '0')})</span>
				<span class="rate__body">
					<span class="rate__name">{p.name}</span>
					<span class="rate__for">{p.for}</span>
					<span class="rate__inc">{p.inc}</span>
				</span>
				<span class="rate__price"><small>from</small><span data-eur-txt>€{fmt(p.eur)}</span><span data-aed-txt hidden>AED {fmt(p.aed)}</span></span>
			</button>
		))}
	</div>

	<div class="rates__grid">
		{services.map((g) => (
			<div class="rates__group">
				<h3 class="rates__label">{g.title} <em>{g.unit}</em></h3>
				{g.items.map((s) => (
					<button class="rate" type="button" data-id={s.id} data-name={s.name} data-eur={s.eur} data-aed={s.aed} data-mo={s.mo ? '1' : undefined} aria-pressed="false">
						<span class="rate__body">
							<span class="rate__name">{s.name}</span>
							<span class="rate__d">{s.d}</span>
						</span>
						<span class="rate__price"><span data-eur-txt>€{fmt(s.eur)}</span><span data-aed-txt hidden>AED {fmt(s.aed)}</span>{s.mo && <small>/ month</small>}</span>
					</button>
				))}
			</div>
		))}
	</div>

	<div class="rates__group">
		<h3 class="rates__label">Monthly partnerships</h3>
		<div class="rates__three">
			{partnerships.map((m) => (
				<button class="rate rate--card" type="button" data-id={m.id} data-name={m.name + ' partnership'} data-eur={m.eur} data-aed={m.aed} data-mo="1" aria-pressed="false">
					<span class="rate__name">{m.name}</span>
					<span class="rate__d">{m.d}</span>
					<span class="rate__price"><span data-eur-txt>€{fmt(m.eur)}</span><span data-aed-txt hidden>AED {fmt(m.aed)}</span><small>/ month</small></span>
				</button>
			))}
		</div>
	</div>

	<ul class="rates__terms">
		<li>50% deposit to start, 50% on delivery</li>
		<li>2 rounds of revisions included</li>
		<li>Rush under 72h +30%</li>
		<li>Invoiced in EUR or AED, excl. VAT</li>
		<li>PayPal or bank transfer</li>
	</ul>

	<p class="rates__neg">Custom <span>packages</span> available.</p>
	<p class="rates__negnote">Booking more than one service? Prices are open for discussion.</p>

	<div class="rates__links">
		<a class="btn btn--with-icon" href="mailto:farah@fxrxh.com?subject=Project%20enquiry">farah@fxrxh.com</a>
	</div>

	</div>

	<div class="estimate" hidden>
		<span class="estimate__count"></span>
		<span class="estimate__total"></span>
		<a class="btn estimate__send" href="mailto:farah@fxrxh.com">Send to Farah</a>
		<button class="estimate__clear" type="button" aria-label="Clear selection">Clear</button>
	</div>
</section>

<style>
	.rates {
		scroll-margin-top: calc(var(--pad) * 2 + 5rem);
		display: grid;
		gap: clamp(1.8rem, 4vw, 3rem);
		margin-top: clamp(2rem, 6vh, 4rem);
		padding-top: clamp(1.5rem, 3vw, 2.5rem);
		padding-bottom: 4rem;
		border-top: 1px solid currentColor;
		max-width: 72rem;
		width: 100%;
	}
	.rates__panel { display: grid; gap: clamp(1.8rem, 4vw, 3rem); }
	.rates__panel[hidden] { display: none; }
	.rates__open {
		all: unset;
		box-sizing: border-box;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-size: clamp(1.55rem, 4.4vw, 3.6rem);
		line-height: 1.02;
		letter-spacing: var(--track);
		text-transform: uppercase;
		transition: color 0.2s ease;
	}
	.rates__open em { font-style: italic; opacity: 0.55; transition: opacity 0.2s ease; }
	.rates__open:hover, .rates__open[aria-expanded='true'] { color: var(--hot); }
	.rates__open:hover em { opacity: 1; }
	.rates__open:focus-visible { outline: 1px solid var(--hot); outline-offset: 4px; }
	.rates__chev { width: 0.7em; height: 0.7em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: square; flex-shrink: 0; transition: transform 0.3s var(--ease-smooth); }
	.rates__open[aria-expanded='true'] .rates__chev { transform: rotate(180deg); }
	.rates__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; }
	.rates__title { font-weight: 400; font-size: clamp(1.55rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: var(--track); }
	.rates__cur { display: flex; gap: 0.4rem; }
	.rates__cur .btn { background: none; color: inherit; cursor: pointer; }
	.rates__cur .btn.is-on { background: var(--hot); border-color: var(--hot); color: #000; }
	.rates__hint { margin-top: -1rem; opacity: 0.55; }
	.rates__tap { display: flex; align-items: center; gap: 0.7rem; font-size: clamp(1.1rem, 2.4vw, 1.9rem); line-height: 1.1; letter-spacing: var(--track); max-width: 40rem; }
	.rates__tap em { font-style: italic; color: var(--hot); }
	.rates__dot { flex-shrink: 0; width: 0.6em; height: 0.6em; border-radius: 50%; background: var(--hot); animation: rates-pulse 1.8s ease-in-out infinite; }
	@keyframes rates-pulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(0.55); opacity: 0.5; } }
	@media (prefers-reduced-motion: reduce) { .rates__dot { animation: none; } }

	.rates__group { display: grid; }
	.rates__label { font-weight: 400; font-size: var(--fs-small); padding-bottom: 0.7rem; border-bottom: 1px solid currentColor; display: flex; justify-content: space-between; }
	.rates__label em { font-style: italic; opacity: 0.55; }

	.rate {
		all: unset;
		box-sizing: border-box;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.3rem 1rem;
		align-items: baseline;
		padding: 0.9rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.16);
		cursor: pointer;
		text-transform: uppercase;
		transition: color 0.2s ease;
	}
	.rate--pkg { grid-template-columns: 3.2rem minmax(0, 1fr) auto; padding: 1.2rem 0; }
	.rate:hover, .rate[aria-pressed='true'] { color: var(--hot); }
	.rate:focus-visible { outline: 1px solid var(--hot); outline-offset: 2px; }
	.rate__no { opacity: 0.55; }
	.rate__body { display: grid; gap: 0.3rem; min-width: 0; }
	.rate__name { font-size: clamp(0.95rem, 1.6vw, 1.3rem); letter-spacing: var(--track); line-height: 1.1; }
	.rate--pkg .rate__name { font-size: clamp(1.25rem, 2.8vw, 2.3rem); font-style: italic; }
	.rate__for, .rate__d { opacity: 0.55; }
	.rate__inc { opacity: 0.8; text-transform: none; max-width: 52rem; }
	.rate__price { text-align: right; white-space: nowrap; font-size: clamp(0.95rem, 1.6vw, 1.3rem); letter-spacing: var(--track); color: var(--hot); }
	.rate--pkg .rate__price { font-size: clamp(1.25rem, 2.8vw, 2.3rem); }
	.rate__price small { display: block; font-size: var(--fs-small); color: #fff; opacity: 0.55; letter-spacing: var(--track-small); }
	.rate--pkg .rate__price small { display: inline; margin-right: 0.4em; }
	.rate__name::before { content: '○ '; opacity: 0.7; }
	.rate[aria-pressed='true'] .rate__name::before { content: '● '; opacity: 1; }
	.rate:hover .rate__name { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }

	.rates__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.8rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3rem); }
	.rates__grid > .rates__group:last-child:nth-child(odd) { grid-column: 1 / -1; }
	.rates__three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
	.rate--card { grid-template-columns: 1fr; padding: 1.1rem 1rem 1.1rem 0; border-bottom: 0; }
	.rate--card + .rate--card { padding-left: 1rem; border-left: 1px solid rgba(255, 255, 255, 0.16); }
	.rate--card .rate__price { text-align: left; margin-top: 0.6rem; font-size: clamp(1.25rem, 2.8vw, 2.3rem); }

	.rates__terms { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.rates__terms li { border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 999px; padding: 0.55em 1em; }
	.rates__neg { font-size: clamp(1.55rem, 4.4vw, 3.6rem); line-height: 1.02; letter-spacing: var(--track); font-style: italic; }
	.rates__neg span { color: var(--hot); }
	.rates__negnote { margin-top: -1.2rem; opacity: 0.55; }
	.rates__links { display: flex; gap: 0.5rem; flex-wrap: wrap; }
	.rates__links .btn { font-size: clamp(0.72rem, 1.05vw, 0.95rem); }

	.estimate {
		position: fixed;
		left: 50%;
		bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
		transform: translateX(-50%);
		z-index: 20;
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.45rem 0.45rem 0.45rem 1.1rem;
		border-radius: 999px;
		background: #000;
		border: 1px solid var(--hot);
		white-space: nowrap;
		max-width: calc(100vw - 2rem);
	}
	.estimate[hidden] { display: none; }
	/* the running total only floats while the rates are open */
	.rates__panel[hidden] ~ .estimate { display: none; }
	.estimate__count { opacity: 0.55; }
	.estimate__total { color: var(--hot); font-size: clamp(0.9rem, 1.4vw, 1.1rem); }
	.estimate__send { background: var(--hot); border-color: var(--hot); color: #000; }
	.estimate__clear { all: unset; cursor: pointer; opacity: 0.55; padding-right: 0.6rem; text-transform: uppercase; }

	@media (max-width: 820px) {
		.rates__grid, .rates__three { grid-template-columns: minmax(0, 1fr); }
		.rate--card + .rate--card { padding-left: 0; border-left: 0; border-top: 1px solid rgba(255, 255, 255, 0.16); }
		.rate--pkg { grid-template-columns: 2.4rem minmax(0, 1fr); }
		.rate--pkg .rate__price { grid-column: 2; text-align: left; }
		.estimate__count { display: none; }
	}
</style>

<script>
	const root = document.getElementById('rates');
	if (root) {
		const opener = root.querySelector<HTMLButtonElement>('.rates__open')!;
		const panel = root.querySelector<HTMLElement>('.rates__panel')!;
		const setOpen = (open: boolean) => {
			panel.hidden = !open;
			opener.setAttribute('aria-expanded', String(open));
		};
		opener.addEventListener('click', () => setOpen(panel.hidden));
		// Arriving from the menu's Rates link (/about#rates) opens it straight away.
		const fromHash = () => {
			if (location.hash === '#rates') {
				setOpen(true);
				root.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		};
		fromHash();
		window.addEventListener('hashchange', fromHash);

		let cur: 'eur' | 'aed' = 'eur';
		const picked = new Set<HTMLElement>();
		const bar = root.querySelector<HTMLElement>('.estimate')!;
		const fmt = (n: number) => (cur === 'eur' ? '€' : 'AED ') + n.toLocaleString('en-US');

		const render = () => {
			bar.hidden = picked.size === 0;
			const items = [...picked];
			const one = items.filter((b) => !b.dataset.mo).reduce((s, b) => s + Number(b.dataset[cur]), 0);
			const mo = items.filter((b) => b.dataset.mo).reduce((s, b) => s + Number(b.dataset[cur]), 0);
			root.querySelector('.estimate__count')!.textContent = `${items.length} selected`;
			const parts = [];
			if (one) parts.push(`from ${fmt(one)}`);
			if (mo) parts.push(`${one ? '+ ' : 'from '}${fmt(mo)}/mo`);
			root.querySelector('.estimate__total')!.textContent = parts.join(' ');
			const body = `Hi Farah,\n\nI'm interested in:\n${items.map((b) => `- ${b.dataset.name} (${fmt(Number(b.dataset[cur]))}${b.dataset.mo ? '/month' : ''})`).join('\n')}\n\nAbout my project:\n`;
			root.querySelector<HTMLAnchorElement>('.estimate__send')!.href = `mailto:farah@fxrxh.com?subject=${encodeURIComponent('Project enquiry')}&body=${encodeURIComponent(body)}`;
		};

		root.querySelectorAll<HTMLElement>('.rate').forEach((b) =>
			b.addEventListener('click', () => {
				const on = !picked.has(b);
				on ? picked.add(b) : picked.delete(b);
				b.setAttribute('aria-pressed', String(on));
				render();
			}),
		);

		root.querySelector('.estimate__clear')!.addEventListener('click', () => {
			picked.forEach((b) => b.setAttribute('aria-pressed', 'false'));
			picked.clear();
			render();
		});

		root.querySelectorAll<HTMLButtonElement>('.rates__cur .btn').forEach((btn) =>
			btn.addEventListener('click', () => {
				cur = btn.dataset.cur as 'eur' | 'aed';
				root.querySelectorAll<HTMLButtonElement>('.rates__cur .btn').forEach((x) => {
					x.classList.toggle('is-on', x === btn);
					x.setAttribute('aria-pressed', String(x === btn));
				});
				root.querySelectorAll<HTMLElement>('[data-eur-txt]').forEach((el) => (el.hidden = cur !== 'eur'));
				root.querySelectorAll<HTMLElement>('[data-aed-txt]').forEach((el) => (el.hidden = cur !== 'aed'));
				render();
			}),
		);
	}
</script>
